208 RCDATA "@CMAKE_SOURCE_DIR@/resources/fonts/Roboto-Bold.ttf"
209 RCDATA "@CMAKE_SOURCE_DIR@/resources/fonts/MaterialSymbolsRounded.ttf"

// 3. Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,3,0,1
PRODUCTVERSION  0,3,0,1
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
