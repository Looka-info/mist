import { Theme } from "../theme.slint";

export component TextField {
    in-out property <string> text: "";
    in property <string> placeholder: "Type here...";
    in property <bool> enabled: true;
    callback edited(string);
    callback accepted();

    height: 44px;

    rect := Rectangle {
        background: Theme.surface;
        border-radius: Theme.radius-small;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.primary : Theme.surface-border;

        animate border-color { duration: 150ms; }

        input := TextInput {
            x: Theme.space-md;
            width: parent.width - (Theme.space-md * 2);
            height: parent.height;
            text <=> root.text;
            color: Theme.text-primary;
            font-size: 14px;
            vertical-alignment: center;
            enabled: root.enabled;

            edited => { root.edited(self.text); }
            accepted => { root.accepted(); }
        }

        if root.text == "" && !input.has-focus : Text {
            x: Theme.space-md;
            text: root.placeholder;
            color: Theme.text-disabled;
            font-size: 14px;
            vertical-alignment: center;
        }
    }
}
