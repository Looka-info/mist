import { Theme } from "../theme.slint";
import { SecondaryButton } from "secondary-button.slint";

export component PairingCodeInput {
    in-out property <string> code: "";
    in property <bool> enabled: true;
    callback edited(string);
    callback paste-clicked();
    callback submitted();

    height: 60px;

    Rectangle {
        background: Theme.surface;
        border-radius: Theme.radius-medium;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.primary : Theme.surface-border;

        animate border-color { duration: 150ms; }

        HorizontalLayout {
            padding-left: Theme.space-lg;
            padding-right: Theme.space-md;
            alignment: space-between;

            input := TextInput {
                text <=> root.code;
                color: Theme.primary;
                font-size: 24px;
                font-weight: 700;
                letter-spacing: 6px;
                vertical-alignment: center;
                enabled: root.enabled;

                edited => { root.edited(self.text); }
                accepted => { root.submitted(); }
            }

            if root.code == "" && !input.has-focus : Text {
                text: "ENTER 6-CHAR CODE";
                color: Theme.text-disabled;
                font-size: 16px;
                font-weight: 600;
                letter-spacing: 2px;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;

                SecondaryButton {
                    text: "Paste";
                    min-width: 70px;
                    clicked => { root.paste-clicked(); }
                }
            }
        }
    }
}
