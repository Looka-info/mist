import { Theme } from "../theme.slint";

export component StatusIndicator {
    in property <bool> is-active: false;
    in property <string> active-text: "Online";
    in property <string> inactive-text: "Offline";

    HorizontalLayout {
        spacing: Theme.space-sm;

        VerticalLayout {
            alignment: center;
            dot := Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.is-active ? Theme.primary : Theme.text-disabled;

                animate background { duration: 200ms; }
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.is-active ? root.active-text : root.inactive-text;
                color: root.is-active ? Theme.text-primary : Theme.text-secondary;
                font-size: 13px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
    }
}
