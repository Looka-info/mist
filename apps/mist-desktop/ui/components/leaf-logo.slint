import { Theme } from "../theme.slint";

export component LeafLogo {
    in property <length> logo-size: 32px;
    in property <bool> show-border: true;

    width: logo-size;
    height: logo-size;

    container := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.logo-size / 2;
        background: #FFFFFF;
        border-width: root.show-border ? 1px : 0px;
        border-color: Theme.surface-border;
        clip: true;

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                // Organic Leaf Vector (Material Design Leaf Motif)
                Path {
                    width: root.logo-size * 0.62;
                    height: root.logo-size * 0.62;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    fill: Theme.primary;

                    // Leaf silhouette with internal rib/vein aperture
                    commands: "M 17 3 C 12 3 7 7.5 7 13 C 7 15.2 7.8 17.2 9.1 18.8 L 6 22 L 7.4 22 L 10.3 19.3 C 12.1 20.4 14.3 21 17 21 C 21.4 21 21 16 21 13 C 21 7.5 19 3 17 3 Z M 16.5 5.2 C 17.8 8.6 18.5 12 18.5 14 C 16 14 13.5 13 11.5 11.2 C 13 8.5 14.8 6.5 16.5 5.2 Z";
                }
            }
        }
    }
}
