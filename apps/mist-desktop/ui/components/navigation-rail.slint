import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";

export component NavItem {
    in property <string> icon-name: "home";
    in property <string> label: "Home";
    in property <bool> is-active: false;
    in property <int> badge-count: 0;
    in property <bool> is-collapsed: false;
    callback clicked();

    height: Theme.compact-view ? 46px : 52px;

    rect := Rectangle {
        background: root.is-active ? Theme.container :
                    touch.has-hover ? Theme.item-hover : #00000000;
        border-radius: Theme.radius-pill;
        clip: true;

        animate background { duration: 150ms; }

        if !root.is-collapsed : HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            spacing: 14px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 14px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    width: 24px;

                    MaterialIcon {
                        name: root.icon-name;
                        icon-size: 22px;
                        icon-color: root.is-active ? Theme.on-container :
                                    touch.has-hover ? Theme.text-ink : Theme.text-mute;
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Text {
                        text: root.label;
                        color: root.is-active ? Theme.on-container :
                                touch.has-hover ? Theme.text-ink : Theme.text-mute;
                        font-size: 15px;
                        font-weight: root.is-active ? 600 : 500;
                        vertical-alignment: center;
                    }
                }
            }

            if root.badge-count > 0 : VerticalLayout {
                alignment: center;
                Rectangle {
                    background: Theme.mint;
                    border-radius: Theme.radius-pill;
                    height: 20px;
                    min-width: 20px;

                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        alignment: center;

                        Text {
                            text: root.badge-count;
                            color: Theme.on-mint;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        if root.is-collapsed : MaterialIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.icon-name;
            icon-size: 22px;
            icon-color: root.is-active ? Theme.on-container :
                        touch.has-hover ? Theme.text-ink : Theme.text-mute;
        }
    }

    if root.is-collapsed && root.badge-count > 0 : Rectangle {
        x: parent.width - 20px;
        y: 6px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.mint;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component NavigationRail {
    in property <int> active-tab: 0;
    in property <int> requests-count: 1;
    in property <string> system-caption: "v0.3.0\nWindows 11 · GTX 1660 SUPER";
    in-out property <bool> is-collapsed: false;
    callback tab-selected(int);
    callback toggle-collapsed();

    width: root.is-collapsed ? 68px : (Theme.compact-view ? 220px : 250px);
    animate width { duration: 180ms; easing: ease-out; }

    Rectangle {
        background: Theme.background;
        border-width: 0px;
        border-color: Theme.border-line;
        clip: true;

        VerticalLayout {
            padding-top: 8px;
            padding-bottom: 20px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 4px;
            alignment: space-between;

            VerticalLayout {
                spacing: 4px;

                // Application Brand Title + Collapse/Expand Toggle
                HorizontalLayout {
                    padding-left: root.is-collapsed ? 8px : 14px;
                    padding-right: root.is-collapsed ? 6px : 8px;
                    padding-top: 10px;
                    padding-bottom: 12px;
                    alignment: space-between;

                    if !root.is-collapsed : Text {
                        text: "Mist";
                        font-size: 24px;
                        font-weight: 700;
                        color: Theme.text-ink;
                        vertical-alignment: center;
                    }

                    if root.is-collapsed : Text {
                        text: "M";
                        font-size: 22px;
                        font-weight: 800;
                        color: Theme.mint;
                        vertical-alignment: center;
                    }

                    // Toggle Button
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: col-touch.has-hover ? Theme.item-hover : #00000000;
                        animate background { duration: 120ms; }

                        MaterialIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: root.is-collapsed ? "chevron_right" : "chevron_left";
                            icon-size: 20px;
                            icon-color: Theme.text-mute;
                        }

                        col-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.is-collapsed = !root.is-collapsed;
                                root.toggle-collapsed();
                            }
                        }
                    }
                }

                // 5 Main Navigation Items
                NavItem {
                    icon-name: "home";
                    label: "Home";
                    is-active: root.active-tab == 0;
                    is-collapsed: root.is-collapsed;
                    clicked => { root.tab-selected(0); }
                }

                NavItem {
                    icon-name: "cast";
                    label: "Host";
                    is-active: root.active-tab == 1;
                    is-collapsed: root.is-collapsed;
                    clicked => { root.tab-selected(1); }
                }

                NavItem {
                    icon-name: "sports_esports";
                    label: "Connect";
                    is-active: root.active-tab == 2;
                    is-collapsed: root.is-collapsed;
                    clicked => { root.tab-selected(2); }
                }

                NavItem {
                    icon-name: "group";
                    label: "Friends";
                    is-active: root.active-tab == 3;
                    badge-count: root.requests-count;
                    is-collapsed: root.is-collapsed;
                    clicked => { root.tab-selected(3); }
                }

                NavItem {
                    icon-name: "network_check";
                    label: "Network";
                    is-active: root.active-tab == 4;
                    is-collapsed: root.is-collapsed;
                    clicked => { root.tab-selected(4); }
                }
            }

            // Bottom System & Version Information
            HorizontalLayout {
                padding-left: root.is-collapsed ? 4px : 14px;
                padding-right: root.is-collapsed ? 4px : 14px;
                padding-top: 16px;
                alignment: root.is-collapsed ? center : start;

                Text {
                    text: root.is-collapsed ? "v0.3" : root.system-caption;
                    color: Theme.text-mute;
                    font-size: root.is-collapsed ? 11px : 12px;
                    horizontal-alignment: root.is-collapsed ? center : left;
                }
            }
        }
    }
}
