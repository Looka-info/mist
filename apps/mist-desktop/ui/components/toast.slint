import { Theme } from "../theme.slint";
import { MaterialIcon } from "material-icon.slint";

export component Toast {
    in property <bool> is-visible: false;
    in property <string> message: "Action successful";

    if root.is-visible : Rectangle {
        height: 48px;
        background: Theme.primary-container;
        border-radius: Theme.radius-pill;
        border-width: 1px;
        border-color: Theme.primary;

        HorizontalLayout {
            padding-left: Theme.space-lg;
            padding-right: Theme.space-xl;
            spacing: Theme.space-sm;
            alignment: center;

            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: "check_circle";
                    icon-size: 18px;
                    icon-color: Theme.primary;
                }
            }

            Text {
                text: root.message;
                color: Theme.on-primary-container;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
}
