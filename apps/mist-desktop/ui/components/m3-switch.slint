import { Theme } from "../theme.slint";

export component M3Switch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 50px;
    height: 30px;

    track := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 15px;
        background: root.checked ? Theme.mint : Theme.container-subtle;
        border-width: 1.5px;
        border-color: root.checked ? Theme.mint : Theme.border-line;

        animate background { duration: 150ms; }
        animate border-color { duration: 150ms; }

        knob := Rectangle {
            width: root.checked ? 20px : 16px;
            height: root.checked ? 20px : 16px;
            border-radius: root.checked ? 10px : 8px;
            background: root.checked ? Theme.surface : Theme.text-mute;
            x: root.checked ? 23px : 5px;
            y: (parent.height - self.height) / 2;

            animate x { duration: 150ms; easing: ease-out; }
            animate width { duration: 150ms; }
            animate height { duration: 150ms; }
            animate background { duration: 150ms; }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}
