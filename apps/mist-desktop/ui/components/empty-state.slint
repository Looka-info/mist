import { Theme } from "../theme.slint";
import { PrimaryButton } from "primary-button.slint";
import { MaterialIcon } from "material-icon.slint";

export component EmptyState {
    in property <string> icon: "";
    in property <string> icon-name: "devices";
    in property <string> title: "No Devices Paired";
    in property <string> description: "Start Wi-Fi Screen Share or connect with a 6-character code to begin streaming.";
    in property <string> button-text: "Start Sharing";
    callback action-clicked();

    VerticalLayout {
        alignment: center;
        spacing: Theme.space-lg;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 72px;
                height: 72px;
                border-radius: 36px;
                background: Theme.primary-container;

                MaterialIcon {
                    name: root.icon-name != "" ? root.icon-name : "devices";
                    icon-size: 36px;
                    icon-color: Theme.primary;
                    y: (parent.height - self.height) / 2;
                    x: (parent.width - self.width) / 2;
                }
            }
        }

        VerticalLayout {
            spacing: Theme.space-xs;

            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: 19px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: root.description;
                color: Theme.text-secondary;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        HorizontalLayout {
            alignment: center;

            PrimaryButton {
                text: root.button-text;
                icon-name: "wifi_tethering";
                clicked => { root.action-clicked(); }
            }
        }
    }
}
