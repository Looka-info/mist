import { Theme } from "../theme.slint";

export component PermissionSwitch {
    in-out property <bool> checked: false;
    in property <string> text: "Enable feature";
    in property <bool> enabled: true;
    callback toggled(bool);

    height: 36px;

    HorizontalLayout {
        alignment: space-between;

        Text {
            text: root.text;
            color: root.enabled ? Theme.text-primary : Theme.text-disabled;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
        }

        track := Rectangle {
            width: 48px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 13px;
            background: root.checked ? Theme.primary : Theme.surface-variant;
            border-width: 1px;
            border-color: root.checked ? Theme.primary : Theme.surface-border;

            animate background, border-color { duration: 150ms; easing: ease-out; }

            thumb := Rectangle {
                width: 20px;
                height: 20px;
                y: 2px;
                x: root.checked ? 24px : 3px;
                border-radius: 10px;
                background: root.checked ? Theme.on-primary : Theme.text-secondary;

                animate x { duration: 150ms; easing: ease-out; }
            }

            TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.checked = !root.checked;
                    root.toggled(root.checked);
                }
            }
        }
    }
}
