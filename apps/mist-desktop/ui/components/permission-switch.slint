import { Theme } from "../theme.slint";

export component PermissionSwitch {
    in-out property <bool> checked: false;
    in property <string> text: "Enable feature";
    in property <bool> enabled: true;
    callback toggled(bool);

    height: 40px;

    HorizontalLayout {
        alignment: space-between;

        Text {
            text: root.text;
            color: root.enabled ? Theme.text-primary : Theme.text-disabled;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
        }

        track := Rectangle {
            width: 52px;
            height: 30px;
            y: (parent.height - self.height) / 2;
            border-radius: 15px;
            background: !root.enabled ? Theme.surface-variant :
                        root.checked ? Theme.primary : Theme.surface-container-high;
            border-width: 1.5px;
            border-color: !root.enabled ? Theme.surface-border :
                          root.checked ? Theme.primary : Theme.surface-border-strong;

            animate background, border-color { duration: 180ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }

            thumb := Rectangle {
                width: root.checked ? 22px : 18px;
                height: root.checked ? 22px : 18px;
                y: (parent.height - self.height) / 2;
                x: root.checked ? 25px : 4px;
                border-radius: 11px;
                background: !root.enabled ? Theme.text-disabled :
                            root.checked ? Theme.on-primary : Theme.text-secondary;

                animate x, width, height, background { duration: 180ms; easing: cubic-bezier(0.2, 0.0, 0, 1.0); }
            }

            TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    root.checked = !root.checked;
                    root.toggled(root.checked);
                }
            }
        }
    }
}
