import { Theme } from "../theme.slint";
import { LeafLogo } from "../components/leaf-logo.slint";
import { MaterialIcon } from "../components/material-icon.slint";

export component AboutScreen inherits Rectangle {
    Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: max(self.height, content.preferred-height);

        content := VerticalLayout {
            width: parent.width;
            padding: Theme.space-xl;
            spacing: Theme.space-xl;
            alignment: start;

            // Header Section with Leaf Logo
            HorizontalLayout {
                spacing: Theme.space-lg;
                alignment: start;

                LeafLogo {
                    logo-size: 68px;
                    show-border: true;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-xs;

                    Text {
                        text: "Mist Desktop Platform";
                        color: Theme.text-primary;
                        font-size: 24px;
                        font-weight: 800;
                    }

                    Text {
                        text: "Version 0.3.0 • Windows 11 Native Architecture (Material 3)";
                        color: Theme.primary;
                        font-size: 14px;
                        font-weight: 600;
                    }
                }
            }

            // Description Card
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-large;
                border-width: 1px;
                border-color: Theme.surface-border;
                clip: true;

                // Material 3 Decorative Corner Arch
                Rectangle {
                    width: 160px;
                    height: 160px;
                    border-top-left-radius: 80px;
                    border-top-right-radius: 80px;
                    border-bottom-left-radius: 24px;
                    border-bottom-right-radius: 24px;
                    background: #DCFCE745;
                    border-width: 1px;
                    border-color: #15803D16;
                    x: parent.width - 110px;
                    y: -50px;
                }

                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    HorizontalLayout {
                        spacing: Theme.space-sm;

                        VerticalLayout {
                            alignment: center;
                            MaterialIcon {
                                name: "info";
                                icon-size: 18px;
                                icon-color: Theme.primary;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "About Mist";
                                color: Theme.text-primary;
                                font-size: 16px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: "Mist is an ultra-low latency peer-to-peer game-streaming application designed for Windows 11. It leverages direct GPU memory capture, hardware-accelerated video encoding and decoding, WASAPI loopback audio, and WebRTC data channels to deliver a seamless remote gaming experience.";
                        color: Theme.text-secondary;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                }
            }

            // Subsystem & Technology Card
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-large;
                border-width: 1px;
                border-color: Theme.surface-border;

                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-sm;

                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            MaterialIcon {
                                name: "settings";
                                icon-size: 18px;
                                icon-color: Theme.primary;
                            }
                        }

                        Text {
                            text: "Underlying Subsystems & Technologies";
                            color: Theme.text-primary;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    Text { text: "• Application & UI: Rust 2021 + Slint 1.18.1 Native Desktop Engine"; color: Theme.text-secondary; font-size: 13px; }
                    Text { text: "• Video Capture: DXGI Desktop Duplication 1.2"; color: Theme.text-secondary; font-size: 13px; }
                    Text { text: "• Hardware Encoder: NVIDIA NVENC H.264 Ultra-Low Latency"; color: Theme.text-secondary; font-size: 13px; }
                    Text { text: "• Hardware Decoder: Microsoft Media Foundation D3D11VA"; color: Theme.text-secondary; font-size: 13px; }
                    Text { text: "• Audio Pipeline: Windows WASAPI Loopback + Xiph Opus Audio"; color: Theme.text-secondary; font-size: 13px; }
                    Text { text: "• Transport: RFC 8829 WebRTC (libdatachannel / Rust Signaling)"; color: Theme.text-secondary; font-size: 13px; }
                    Text { text: "• Inter-Process: Win32 Named Pipes Message Protocol"; color: Theme.text-secondary; font-size: 13px; }
                }
            }

            // Licensing & Attribution Card
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-large;
                border-width: 1px;
                border-color: Theme.surface-border;

                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-sm;

                    Text {
                        text: "Open Source Licensing & Third-Party Attribution";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 700;
                    }

                    Text { text: "Slint UI Toolkit © SixtyFPS GmbH. Licensed under GPLv3 / Commercial."; color: Theme.text-secondary; font-size: 12px; }
                    Text { text: "libdatachannel © Paul-Louis Ageneau. Licensed under MPL 2.0."; color: Theme.text-secondary; font-size: 12px; }
                    Text { text: "Mbed TLS © Arm Limited. Licensed under Apache 2.0."; color: Theme.text-secondary; font-size: 12px; }
                    Text { text: "Opus Audio Codec © Xiph.Org Foundation. Licensed under BSD 3-Clause."; color: Theme.text-secondary; font-size: 12px; }
                    Text { text: "Tokio Async Engine © Tokio Contributors. Licensed under MIT."; color: Theme.text-secondary; font-size: 12px; }
                }
            }
        }
    }
}
