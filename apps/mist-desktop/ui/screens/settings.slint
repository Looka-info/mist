import { Theme } from "../theme.slint";
import { PrimaryButton } from "../components/primary-button.slint";
import { SecondaryButton } from "../components/secondary-button.slint";
import { PermissionSwitch } from "../components/permission-switch.slint";
import { TextField } from "../components/text-field.slint";

export component SettingsScreen {
    in-out property <bool> dark-theme: true;
    in-out property <bool> high-contrast: false;
    in-out property <int> fps: 60;
    in-out property <int> bitrate-kbps: 12000;
    in-out property <string> signaling-url: "ws://127.0.0.1:8080";
    in-out property <string> stun-server: "stun:stun.l.google.com:19302";
    in-out property <bool> audio-enabled: true;

    // Advanced Video & Codec settings
    in-out property <string> codec: "auto";
    in-out property <bool> hdr-enabled: false;
    in-out property <string> capture-backend: "auto";

    // Remote Host & Headless Virtual Display
    in-out property <string> wol-mac: "";
    in-out property <bool> virtual-display-enabled: false;
    in-out property <string> virtual-display-res: "1080p60";

    callback save-clicked();
    callback reset-clicked();
    callback send-wol(string);
    callback toggle-virtual-display();

    Flickable {
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-xl;
            alignment: start;

            // Screen Header
            VerticalLayout {
                spacing: Theme.space-xs;

                Text {
                    text: "Settings & Preferences";
                    color: Theme.text-primary;
                    font-size: 24px;
                    font-weight: 700;
                }

                Text {
                    text: "Configure video streaming quality, hardware codecs, audio endpoints, network servers, and remote power.";
                    color: Theme.text-secondary;
                    font-size: 14px;
                }
            }

            // Appearance Section
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-large;
                border-width: 1px;
                border-color: Theme.surface-border;

                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    Text {
                        text: "Appearance";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 600;
                    }

                    PermissionSwitch {
                        text: "Dark Theme (Material Design 3 Pixel Mint)";
                        checked <=> root.dark-theme;
                    }

                    PermissionSwitch {
                        text: "High Contrast Outlines";
                        checked <=> root.high-contrast;
                    }
                }
            }

            // Video Encoding & Codec Section
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-large;
                border-width: 1px;
                border-color: Theme.surface-border;

                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    Text {
                        text: "Video Streaming & Codecs";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 600;
                    }

                    // Codec Selection
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: Theme.space-xs;
                            Text { text: "Video Codec: " + (root.codec == "auto" ? "Auto-Negotiated" : root.codec == "av1" ? "AV1 (Next-Gen)" : root.codec == "hevc" ? "HEVC / H.265" : "H.264 (Universal)"); color: Theme.text-primary; font-size: 14px; font-weight: 500; }
                            Text { text: "AV1 offers ~30% higher compression efficiency on RTX 40-series and modern devices"; color: Theme.text-secondary; font-size: 12px; }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-sm;

                            SecondaryButton {
                                text: "Auto";
                                min-width: 60px;
                                clicked => { root.codec = "auto"; }
                            }
                            SecondaryButton {
                                text: "AV1";
                                min-width: 60px;
                                clicked => { root.codec = "av1"; }
                            }
                            SecondaryButton {
                                text: "HEVC";
                                min-width: 60px;
                                clicked => { root.codec = "hevc"; }
                            }
                            SecondaryButton {
                                text: "H.264";
                                min-width: 60px;
                                clicked => { root.codec = "h264"; }
                            }
                        }
                    }

                    // HDR10 Toggle
                    PermissionSwitch {
                        text: "HDR10 & 10-Bit Color (BT.2020 PQ & P010 surface capture)";
                        checked <=> root.hdr-enabled;
                    }

                    // Frame Rate Selection
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: Theme.space-xs;
                            Text { text: "Target Frame Rate: " + root.fps + " FPS"; color: Theme.text-primary; font-size: 14px; font-weight: 500; }
                            Text { text: "Controls rendering and encoder presentation cadence"; color: Theme.text-secondary; font-size: 12px; }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-sm;

                            SecondaryButton {
                                text: "30 FPS";
                                min-width: 70px;
                                clicked => { root.fps = 30; }
                            }

                            PrimaryButton {
                                text: "60 FPS";
                                min-width: 70px;
                                clicked => { root.fps = 60; }
                            }

                            SecondaryButton {
                                text: "120 FPS";
                                min-width: 70px;
                                clicked => { root.fps = 120; }
                            }
                        }
                    }

                    // Streaming Bitrate Selection
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: Theme.space-xs;
                            Text { text: "Streaming Bitrate: " + (root.bitrate-kbps / 1000) + " Mbps"; color: Theme.text-primary; font-size: 14px; font-weight: 500; }
                            Text { text: "Strict bounded range between 2 Mbps and 25 Mbps"; color: Theme.text-secondary; font-size: 12px; }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-sm;

                            SecondaryButton {
                                text: "6 Mbps";
                                min-width: 70px;
                                clicked => { root.bitrate-kbps = 6000; }
                            }

                            PrimaryButton {
                                text: "12 Mbps";
                                min-width: 70px;
                                clicked => { root.bitrate-kbps = 12000; }
                            }

                            SecondaryButton {
                                text: "20 Mbps";
                                min-width: 70px;
                                clicked => { root.bitrate-kbps = 20000; }
                            }
                        }
                    }

                    // Capture Engine Backend
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: Theme.space-xs;
                            Text { text: "Screen Capture Backend: " + (root.capture-backend == "auto" ? "Automatic (Cascading)" : root.capture-backend == "dxgi" ? "DXGI Desktop Duplication" : "Windows.Graphics.Capture"); color: Theme.text-primary; font-size: 14px; font-weight: 500; }
                            Text { text: "DXGI for discrete GPUs, WGC for hybrid multi-GPU laptops"; color: Theme.text-secondary; font-size: 12px; }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-sm;

                            SecondaryButton {
                                text: "Auto";
                                min-width: 70px;
                                clicked => { root.capture-backend = "auto"; }
                            }
                            SecondaryButton {
                                text: "DXGI";
                                min-width: 70px;
                                clicked => { root.capture-backend = "dxgi"; }
                            }
                            SecondaryButton {
                                text: "WGC";
                                min-width: 70px;
                                clicked => { root.capture-backend = "wgc"; }
                            }
                        }
                    }
                }
            }

            // Remote Host & Headless Virtual Display Section
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-large;
                border-width: 1px;
                border-color: Theme.surface-border;

                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    Text {
                        text: "Remote Host & Headless Display Management";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 600;
                    }

                    PermissionSwitch {
                        text: "IddCx Virtual Display Driver (for headless hosts & custom resolutions)";
                        checked <=> root.virtual-display-enabled;
                    }

                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: Theme.space-xs;
                            Text { text: "Virtual EDID Resolution: " + root.virtual-display-res; color: Theme.text-primary; font-size: 14px; font-weight: 500; }
                            Text { text: "Generates VESA EDID 1.4 block tailored for connected client"; color: Theme.text-secondary; font-size: 12px; }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-sm;

                            SecondaryButton {
                                text: "1080p60";
                                min-width: 80px;
                                clicked => { root.virtual-display-res = "1080p60"; }
                            }
                            SecondaryButton {
                                text: "1440p120";
                                min-width: 80px;
                                clicked => { root.virtual-display-res = "1440p120"; }
                            }
                            SecondaryButton {
                                text: "4K60";
                                min-width: 80px;
                                clicked => { root.virtual-display-res = "4K60"; }
                            }
                        }
                    }

                    // Wake-on-LAN
                    Text {
                        text: "Wake-on-LAN Host MAC Address";
                        color: Theme.text-secondary;
                        font-size: 13px;
                    }

                    HorizontalLayout {
                        spacing: Theme.space-md;

                        TextField {
                            text <=> root.wol-mac;
                            placeholder: "e.g. 00:11:22:33:44:55";
                        }

                        PrimaryButton {
                            text: "Send WoL Magic Packet";
                            min-width: 180px;
                            clicked => { root.send-wol(root.wol-mac); }
                        }
                    }
                }
            }

            // Audio & Network Section
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-large;
                border-width: 1px;
                border-color: Theme.surface-border;

                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-md;

                    Text {
                        text: "Audio & Network Configuration";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 600;
                    }

                    PermissionSwitch {
                        text: "WASAPI Loopback Audio Streaming (48 kHz, Stereo)";
                        checked <=> root.audio-enabled;
                    }

                    Text {
                        text: "Signaling Server WebSocket URL";
                        color: Theme.text-secondary;
                        font-size: 13px;
                    }

                    TextField {
                        text <=> root.signaling-url;
                        placeholder: "ws://127.0.0.1:8080";
                    }

                    Text {
                        text: "STUN Server Address";
                        color: Theme.text-secondary;
                        font-size: 13px;
                    }

                    TextField {
                        text <=> root.stun-server;
                        placeholder: "stun:stun.l.google.com:19302";
                    }
                }
            }

            // Actions
            HorizontalLayout {
                alignment: end;
                spacing: Theme.space-md;

                SecondaryButton {
                    text: "Reset Defaults";
                    clicked => { root.reset-clicked(); }
                }

                PrimaryButton {
                    text: "Save Settings";
                    min-width: 140px;
                    clicked => { root.save-clicked(); }
                }
            }
        }
    }
}
