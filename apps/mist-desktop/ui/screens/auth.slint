import { Theme } from "../theme.slint";
import { MaterialIcon } from "../components/material-icon.slint";
import { LeafLogo } from "../components/leaf-logo.slint";

export component AuthScreen inherits Rectangle {
    // 0 = Sign In, 1 = Sign Up
    in-out property <int> auth-mode: 0;

    in-out property <string> username-input: "";
    in-out property <string> email-input: "";
    in-out property <string> password-input: "";
    in property <string> error-message: "";
    in property <bool> is-loading: false;

    callback sign-in-google();
    callback sign-in-email(string, string);
    callback sign-up-email(string, string, string);
    callback continue-guest();

    background: #00000000;

    Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;

        VerticalLayout {
            width: parent.width;
            min-height: parent.height;
            alignment: center;
            padding-top: 24px;
            padding-bottom: 32px;

            HorizontalLayout {
                alignment: center;

                // Auth Card
                Rectangle {
                    width: min(440px, root.width - 32px);
                    border-radius: Theme.radius-card;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-line;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: Theme.shadow-color;
                    drop-shadow-offset-y: 8px;

                    VerticalLayout {
                        padding: Theme.card-padding;
                        spacing: 16px;

                        // Header: Logo + App Name
                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;

                            HorizontalLayout {
                                alignment: center;
                                LeafLogo {
                                    logo-size: 44px;
                                }
                            }

                            Text {
                                text: root.auth-mode == 0 ? "Welcome back" : "Create an account";
                                font-size: 22px;
                                font-weight: 600;
                                color: Theme.text-ink;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: root.auth-mode == 0
                                    ? "Sign in to connect with friends and stream games."
                                    : "Join Mist to get your unique gamer tag and start streaming.";
                                font-size: 13px;
                                color: Theme.text-mute;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        // Mode Switcher (Sign In / Sign Up Tabs)
                        Rectangle {
                            height: 38px;
                            border-radius: Theme.radius-pill;
                            background: Theme.container-subtle;
                            border-width: 1px;
                            border-color: Theme.border-line;

                            HorizontalLayout {
                                padding: 3px;
                                spacing: 4px;

                                Rectangle {
                                    border-radius: 16px;
                                    background: root.auth-mode == 0 ? Theme.surface : #00000000;
                                    border-width: root.auth-mode == 0 ? 1px : 0px;
                                    border-color: Theme.border-line;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: "Sign In";
                                        font-size: 13px;
                                        font-weight: root.auth-mode == 0 ? 600 : 500;
                                        color: root.auth-mode == 0 ? Theme.on-container : Theme.text-mute;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.auth-mode = 0;
                                        }
                                    }
                                }

                                Rectangle {
                                    border-radius: 16px;
                                    background: root.auth-mode == 1 ? Theme.surface : #00000000;
                                    border-width: root.auth-mode == 1 ? 1px : 0px;
                                    border-color: Theme.border-line;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: "Create Account";
                                        font-size: 13px;
                                        font-weight: root.auth-mode == 1 ? 600 : 500;
                                        color: root.auth-mode == 1 ? Theme.on-container : Theme.text-mute;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.auth-mode = 1;
                                        }
                                    }
                                }
                            }
                        }

                        // Google Sign-In Button
                        Rectangle {
                            height: 42px;
                            border-radius: Theme.radius-pill;
                            background: google-touch.has-hover ? Theme.item-hover : Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border-line;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        background: #4285F4;
                                        border-radius: 9px;

                                        Text {
                                            text: "G";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #ffffff;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Text {
                                    text: root.auth-mode == 0 ? "Sign in with Google" : "Sign up with Google";
                                    font-size: 14px;
                                    font-weight: 500;
                                    color: Theme.text-ink;
                                    vertical-alignment: center;
                                }
                            }

                            google-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.sign-in-google();
                                }
                            }
                        }

                        // Divider: "or with email"
                        HorizontalLayout {
                            alignment: center;
                            spacing: 12px;

                            Rectangle {
                                height: 1px;
                                background: Theme.border-line;
                                horizontal-stretch: 1;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "or continue with email";
                                font-size: 11px;
                                color: Theme.text-mute;
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border-line;
                                horizontal-stretch: 1;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        // Form Inputs
                        VerticalLayout {
                            spacing: 10px;

                            // Username (Only for Sign Up)
                            if root.auth-mode == 1 : VerticalLayout {
                                spacing: 4px;

                                Text {
                                    text: "Username";
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: Theme.text-mute;
                                }

                                Rectangle {
                                    height: 40px;
                                    border-radius: 10px;
                                    background: Theme.input-bg;
                                    border-width: 1.5px;
                                    border-color: Theme.border-line;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;

                                        TextInput {
                                            text <=> root.username-input;
                                            color: Theme.text-ink;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }

                                        if root.username-input == "" : Text {
                                            text: "e.g. gamer99";
                                            color: Theme.text-placeholder;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Email
                            VerticalLayout {
                                spacing: 4px;

                                Text {
                                    text: "Email address";
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: Theme.text-mute;
                                }

                                Rectangle {
                                    height: 40px;
                                    border-radius: 10px;
                                    background: Theme.input-bg;
                                    border-width: 1.5px;
                                    border-color: Theme.border-line;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;

                                        TextInput {
                                            text <=> root.email-input;
                                            color: Theme.text-ink;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }

                                        if root.email-input == "" : Text {
                                            text: "name@example.com";
                                            color: Theme.text-placeholder;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Password
                            VerticalLayout {
                                spacing: 4px;

                                Text {
                                    text: "Password";
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: Theme.text-mute;
                                }

                                Rectangle {
                                    height: 40px;
                                    border-radius: 10px;
                                    background: Theme.input-bg;
                                    border-width: 1.5px;
                                    border-color: Theme.border-line;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;

                                        TextInput {
                                            text <=> root.password-input;
                                            color: Theme.text-ink;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }

                                        if root.password-input == "" : Text {
                                            text: "••••••••";
                                            color: Theme.text-placeholder;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Error or Status Message
                        if root.error-message != "" : Text {
                            text: root.error-message;
                            font-size: 12px;
                            color: Theme.color-bad;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        // Action Button (Sign In / Sign Up)
                        Rectangle {
                            height: 44px;
                            border-radius: Theme.radius-pill;
                            background: submit-touch.has-hover ? Theme.accent : Theme.mint;
                            animate background { duration: 120ms; }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;

                                Text {
                                    text: root.is-loading ? "Please wait..." :
                                          root.auth-mode == 0 ? "Sign In" : "Create Account & Get Tag";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: Theme.on-mint;
                                    vertical-alignment: center;
                                }
                            }

                            submit-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if root.auth-mode == 0 {
                                        root.sign-in-email(root.email-input, root.password-input);
                                    } else {
                                        root.sign-up-email(root.username-input, root.email-input, root.password-input);
                                    }
                                }
                            }
                        }

                        // Guest Bypass Option
                        HorizontalLayout {
                            alignment: center;

                            Rectangle {
                                height: 28px;
                                border-radius: 14px;
                                background: guest-touch.has-hover ? Theme.item-hover : #00000000;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;

                                    Text {
                                        text: "Continue as Guest (Offline)";
                                        font-size: 12px;
                                        color: Theme.text-mute;
                                        vertical-alignment: center;
                                    }
                                }

                                guest-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.continue-guest();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
