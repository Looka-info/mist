import { Theme } from "../theme.slint";
import { StreamingHud } from "../components/streaming-hud.slint";
import { StatsOverlay } from "../components/stats-overlay.slint";
import { SecondaryButton } from "../components/secondary-button.slint";
import { PrimaryButton } from "../components/primary-button.slint";
import { MaterialIcon } from "../components/material-icon.slint";

export component LiveSessionScreen inherits Rectangle {
    in property <bool> is-active: false;
    in property <string> fps-text: "60 FPS";
    in property <string> bitrate-text: "12.0 Mbps";
    in property <string> rtt-text: "8.5 ms";
    in property <string> jitter-text: "1.2 ms";
    in property <string> loss-text: "0.0%";
    in property <string> resolution-text: "1920 × 1080";
    in property <bool> audio-active: true;
    in property <bool> input-active: true;
    in property <string> quality-profile: "Balanced (12 Mbps)";

    // Advanced Live Session State
    in property <string> active-codec: "AV1 (10-Bit HDR)";
    in property <int> active-display-idx: 0;
    in-out property <bool> relative-mouse-active: true;
    in property <int> active-gamepads-count: 1;
    in property <bool> gamepad-rumble-active: false;

    // Overlay state
    in-out property <bool> overlay-visible: true;
    in-out property <bool> overlay-detailed: false;
    in property <string> capture-latency-text: "850 µs";
    in property <string> encode-latency-text: "1.2 ms";
    in property <string> decode-latency-text: "1.8 ms";
    in property <string> present-latency-text: "0.5 ms";
    in property <string> total-latency-text: "12.3 ms";
    in property <string> codec-text: "AV1 / NV_ENC_CODEC_AV1_GUID";
    in property <string> backend-text: "NVIDIA NVENC → D3D11VA";
    in property <int> fec-recovered: 0;
    in property <int> audio-plc: 0;

    callback disconnect-clicked();
    callback fullscreen-clicked();
    callback change-profile(string);
    callback toggle-overlay();
    callback cycle-display();
    callback toggle-relative-mouse();

    VerticalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-md;

        // Top Streaming HUD
        StreamingHud {
            fps-text: root.fps-text;
            bitrate-text: root.bitrate-text;
            rtt-text: root.rtt-text;
            jitter-text: root.jitter-text;
            loss-text: root.loss-text;
            is-visible: root.is-active;
            disconnect-clicked => { root.disconnect-clicked(); }
        }

        // Main Video Presentation Viewport Area
        viewport := Rectangle {
            background: root.is-active ? #0A100C : Theme.surface-container-low;
            border-radius: Theme.radius-large;
            border-width: 1px;
            border-color: Theme.surface-border;
            clip: true;

            // When no active stream, display waiting message
            if !root.is-active : VerticalLayout {
                alignment: center;
                spacing: Theme.space-lg;

                Rectangle {
                    width: 80px;
                    height: 80px;
                    border-radius: 40px;
                    background: Theme.surface-variant;
                    border-width: 1px;
                    border-color: Theme.surface-border;

                    MaterialIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon-name: "monitor";
                        icon-size: 40px;
                        icon-color: Theme.text-disabled;
                    }
                }

                VerticalLayout {
                    spacing: Theme.space-xs;

                    Text {
                        text: "No Active Stream";
                        color: Theme.text-primary;
                        font-size: 20px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Start Wi-Fi Share from the host or connect with a pairing code to begin streaming.";
                        color: Theme.text-secondary;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }
                }
            }

            // In-stream bottom control bar
            if root.is-active : VerticalLayout {
                alignment: end;
                padding: Theme.space-md;

                Rectangle {
                    height: 48px;
                    background: #FFFFFFF5;
                    border-radius: Theme.radius-pill;
                    border-width: 1px;
                    border-color: Theme.surface-border;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #0F1E1620;

                    HorizontalLayout {
                        padding-left: Theme.space-lg;
                        padding-right: Theme.space-lg;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: Theme.space-lg;
                            alignment: center;

                            Text {
                                text: root.resolution-text;
                                color: Theme.text-primary;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            // Active Codec Badge
                            Rectangle {
                                background: Theme.primary-container;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.primary;
                                height: 24px;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: root.active-codec;
                                        color: Theme.primary;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Display selector
                            Text {
                                text: "Display " + root.active-display-idx;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            // Relative mouse state
                            Text {
                                text: root.relative-mouse-active ? "Mouse: Locked" : "Mouse: Free";
                                color: root.relative-mouse-active ? Theme.primary : Theme.text-secondary;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            // Gamepad slots
                            Text {
                                text: "Gamepads: " + root.active-gamepads-count + (root.gamepad-rumble-active ? " [Rumble]" : "");
                                color: Theme.text-primary;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-md;
                            alignment: center;

                            SecondaryButton {
                                text: "Cycle Display";
                                min-width: 100px;
                                clicked => { root.cycle-display(); }
                            }

                            SecondaryButton {
                                text: root.relative-mouse-active ? "Free Mouse" : "Lock Mouse";
                                min-width: 90px;
                                clicked => {
                                    root.relative-mouse-active = !root.relative-mouse-active;
                                    root.toggle-relative-mouse();
                                }
                            }

                            SecondaryButton {
                                text: root.overlay-visible ? "Hide HUD (F8)" : "Show HUD (F8)";
                                min-width: 110px;
                                clicked => {
                                    root.overlay-visible = !root.overlay-visible;
                                    root.toggle-overlay();
                                }
                            }

                            SecondaryButton {
                                text: "Toggle Fullscreen (F11)";
                                min-width: 150px;
                                clicked => { root.fullscreen-clicked(); }
                            }
                        }
                    }
                }
            }

            // Top-right floating stats HUD overlay
            if root.is-active && root.overlay-visible : HorizontalLayout {
                alignment: end;
                padding-top: Theme.space-md;
                padding-right: Theme.space-md;

                VerticalLayout {
                    alignment: start;

                    StatsOverlay {
                        is-visible: root.overlay-visible;
                        is-detailed: root.overlay-detailed;
                        fps-text: root.fps-text;
                        bitrate-text: root.bitrate-text;
                        rtt-text: root.rtt-text;
                        jitter-text: root.jitter-text;
                        loss-text: root.loss-text;
                        capture-latency-text: root.capture-latency-text;
                        encode-latency-text: root.encode-latency-text;
                        decode-latency-text: root.decode-latency-text;
                        present-latency-text: root.present-latency-text;
                        total-latency-text: root.total-latency-text;
                        codec-text: root.codec-text;
                        backend-text: root.backend-text;
                        resolution-text: root.resolution-text;
                        fec-recovered: root.fec-recovered;
                        audio-plc: root.audio-plc;
                        close-clicked => { root.overlay-visible = false; }
                        toggle-detailed-clicked => { root.overlay-detailed = !root.overlay-detailed; }
                    }
                }
            }
        }
    }
}
