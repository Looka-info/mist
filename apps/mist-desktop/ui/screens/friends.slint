import { Theme } from "../theme.slint";
import { MaterialIcon } from "../components/material-icon.slint";
import { M3Switch } from "../components/m3-switch.slint";

export struct FriendItemData {
    tag: string,
    is-online: bool,
    is-hosting: bool,
    can-join: bool,
    allow-input: bool,
    allow-gamepad: bool,
}

export struct FriendRequestData {
    tag: string,
    is-outgoing: bool,
}

component YourTagCard inherits Rectangle {
    in property <string> my-tag: "";
    callback copy-tag();

    horizontal-stretch: 1;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-line;
    border-radius: Theme.radius-card;
    drop-shadow-blur: 10px;
    drop-shadow-color: Theme.shadow-color;

    VerticalLayout {
        padding: Theme.card-padding;
        spacing: 16px;
        alignment: space-between;

        // Card Header
        HorizontalLayout {
            spacing: 12px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: Theme.container;

                        MaterialIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: "person";
                            icon-size: 20px;
                            icon-color: Theme.on-container;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Your Gamertag";
                        font-size: 16px;
                        font-weight: 600;
                        color: Theme.text-ink;
                    }
                    Text {
                        text: "Peer streaming identity";
                        font-size: 12px;
                        color: Theme.text-mute;
                    }
                }
            }

            // Status chip
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 26px;
                    border-radius: Theme.radius-pill;
                    background: Theme.ok-container;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;

                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.color-ok;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Active";
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.color-ok;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Tag Display & Copy Box
        Rectangle {
            height: 52px;
            border-radius: Theme.radius-medium;
            border-width: 1.5px;
            border-color: Theme.border-line;
            background: Theme.input-bg;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 8px;
                spacing: 10px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;
                        MaterialIcon {
                            name: "vpn_key";
                            icon-size: 18px;
                            icon-color: Theme.accent;
                        }
                    }

                    Text {
                        text: root.my-tag != "" ? root.my-tag : "Loading tag...";
                        font-size: 17px;
                        font-weight: 700;
                        color: Theme.text-ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 36px;
                        border-radius: Theme.radius-pill;
                        background: copy-touch.pressed ? Theme.on-mint :
                                    copy-touch.has-hover ? Theme.accent : Theme.mint;
                        animate background { duration: 150ms; }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 6px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                MaterialIcon {
                                    name: "content_copy";
                                    icon-size: 15px;
                                    icon-color: Theme.on-mint;
                                }
                            }

                            Text {
                                text: "Copy Tag";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.on-mint;
                                vertical-alignment: center;
                            }
                        }

                        copy-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.copy-tag(); }
                        }
                    }
                }
            }
        }

        // Helper Note
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: "info";
                    icon-size: 14px;
                    icon-color: Theme.text-mute;
                }
            }

            Text {
                text: "Share this unique tag with friends to receive pairing invites.";
                font-size: 12px;
                color: Theme.text-mute;
                vertical-alignment: center;
            }
        }
    }
}

component AddFriendCard inherits Rectangle {
    in-out property <string> add-input: "";
    in property <string> add-message: "";
    callback send-request(string);

    horizontal-stretch: 1;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-line;
    border-radius: Theme.radius-card;
    drop-shadow-blur: 10px;
    drop-shadow-color: Theme.shadow-color;

    VerticalLayout {
        padding: Theme.card-padding;
        spacing: 16px;
        alignment: space-between;

        // Card Header
        HorizontalLayout {
            spacing: 12px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.container;

                    MaterialIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        name: "person_add";
                        icon-size: 20px;
                        icon-color: Theme.on-container;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Add a Friend";
                        font-size: 16px;
                        font-weight: 600;
                        color: Theme.text-ink;
                    }
                    Text {
                        text: "Pair with another player";
                        font-size: 12px;
                        color: Theme.text-mute;
                    }
                }
            }
        }

        // Input & Send Action Row
        HorizontalLayout {
            spacing: 10px;

            Rectangle {
                horizontal-stretch: 1;
                height: 52px;
                border-radius: Theme.radius-medium;
                border-width: input-box.has-focus ? 2px : 1.5px;
                border-color: input-box.has-focus ? Theme.primary : Theme.border-line;
                background: Theme.input-bg;
                clip: true;
                animate border-color { duration: 150ms; }

                MaterialIcon {
                    x: 14px;
                    y: (parent.height - self.height) / 2;
                    name: "search";
                    icon-size: 18px;
                    icon-color: input-box.has-focus ? Theme.primary : Theme.text-mute;
                }

                input-box := TextInput {
                    x: 42px;
                    width: parent.width - 52px;
                    height: parent.height;
                    text <=> root.add-input;
                    color: Theme.text-ink;
                    font-size: 14px;
                    vertical-alignment: center;
                    accepted => {
                        if root.add-input != "" {
                            root.send-request(root.add-input);
                        }
                    }
                }

                if root.add-input == "" && !input-box.has-focus : Text {
                    x: 42px;
                    height: parent.height;
                    text: "username#1234";
                    color: Theme.text-placeholder;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 110px;
                height: 52px;
                border-radius: Theme.radius-pill;
                background: root.add-input == "" ? Theme.container-subtle :
                            send-touch.pressed ? Theme.on-mint :
                            send-touch.has-hover ? Theme.accent : Theme.mint;
                animate background { duration: 150ms; }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 6px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        MaterialIcon {
                            name: "person_add";
                            icon-size: 16px;
                            icon-color: root.add-input == "" ? Theme.text-mute : Theme.on-mint;
                        }
                    }

                    Text {
                        text: "Add";
                        font-size: 13px;
                        font-weight: 600;
                        color: root.add-input == "" ? Theme.text-mute : Theme.on-mint;
                        vertical-alignment: center;
                    }
                }

                send-touch := TouchArea {
                    enabled: root.add-input != "";
                    mouse-cursor: root.add-input != "" ? pointer : default;
                    clicked => {
                        root.send-request(root.add-input);
                    }
                }
            }
        }

        // Helper Note or Status Message
        if root.add-message != "" : HorizontalLayout {
            spacing: 6px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: "info";
                    icon-size: 14px;
                    icon-color: Theme.accent;
                }
            }

            Text {
                text: root.add-message;
                font-size: 12px;
                color: Theme.accent;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }

        if root.add-message == "" : HorizontalLayout {
            spacing: 6px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                MaterialIcon {
                    name: "keyboard";
                    icon-size: 14px;
                    icon-color: Theme.text-mute;
                }
            }

            Text {
                text: "Tags are case-sensitive. Press Enter or click Add to send.";
                font-size: 12px;
                color: Theme.text-mute;
                vertical-alignment: center;
            }
        }
    }
}

export component FriendsScreen inherits Rectangle {
    in property <string> my-tag: "";
    in-out property <string> add-input: "";
    in property <string> add-message: "";
    in property <[FriendRequestData]> requests: [];
    in property <[FriendItemData]> friends: [];

    callback copy-tag();
    callback send-request(string);
    callback accept-request(int);
    callback decline-request(int);
    callback cancel-request(int);
    callback remove-friend(int);
    callback friend-input-toggled(int, bool);
    callback friend-gamepad-toggled(int, bool);
    callback connect-to-friend(string);

    property <bool> is-narrow: root.width < 860px;

    Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;

        content := VerticalLayout {
            width: parent.width;
            padding-left: Theme.compact-view ? 16px : 24px;
            padding-right: Theme.compact-view ? 16px : 24px;
            padding-top: Theme.compact-view ? 8px : 12px;
            padding-bottom: 60px;
            spacing: Theme.compact-view ? 16px : 22px;
            alignment: start;

            // Page Header with Stats
            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            MaterialIcon {
                                name: "group";
                                icon-size: 26px;
                                icon-color: Theme.mint;
                            }
                        }

                        Text {
                            text: "Friends";
                            font-size: 28px;
                            font-weight: 700;
                            color: Theme.text-ink;
                        }
                    }

                    Text {
                        text: "Add friends by their tag to stream, invite, and share gamepad or mouse access.";
                        font-size: 14px;
                        color: Theme.text-mute;
                    }
                }

                // Quick Status Badges
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 30px;
                            border-radius: Theme.radius-pill;
                            background: Theme.container;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    MaterialIcon {
                                        name: "group";
                                        icon-size: 15px;
                                        icon-color: Theme.on-container;
                                    }
                                }

                                Text {
                                    text: root.friends.length + " Friends";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.on-container;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if root.requests.length > 0 : VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 30px;
                            border-radius: Theme.radius-pill;
                            background: Theme.ok-container;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    MaterialIcon {
                                        name: "pending";
                                        icon-size: 15px;
                                        icon-color: Theme.color-ok;
                                    }
                                }

                                Text {
                                    text: root.requests.length + " Pending";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.color-ok;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Top 2 Cards: Tag Display & Add Friend
            if !root.is-narrow : HorizontalLayout {
                spacing: 16px;

                YourTagCard {
                    my-tag: root.my-tag;
                    copy-tag => { root.copy-tag(); }
                }

                AddFriendCard {
                    add-input <=> root.add-input;
                    add-message: root.add-message;
                    send-request(t) => { root.send-request(t); }
                }
            }

            if root.is-narrow : VerticalLayout {
                spacing: 16px;

                YourTagCard {
                    my-tag: root.my-tag;
                    copy-tag => { root.copy-tag(); }
                }

                AddFriendCard {
                    add-input <=> root.add-input;
                    add-message: root.add-message;
                    send-request(t) => { root.send-request(t); }
                }
            }

            // Section: Requests
            VerticalLayout {
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;
                        MaterialIcon {
                            name: "pending";
                            icon-size: 18px;
                            icon-color: root.requests.length > 0 ? Theme.accent : Theme.text-mute;
                        }
                    }

                    Text {
                        text: "Requests";
                        font-size: 18px;
                        font-weight: 600;
                        color: Theme.text-ink;
                    }

                    if root.requests.length > 0 : Rectangle {
                        height: 20px;
                        border-radius: Theme.radius-pill;
                        background: Theme.container;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            Text {
                                text: root.requests.length;
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.on-container;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-line;
                    border-radius: Theme.radius-card;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: Theme.shadow-color;

                    VerticalLayout {
                        padding: Theme.card-padding;
                        spacing: 12px;

                        if root.requests.length == 0 : HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                MaterialIcon {
                                    name: "check_circle";
                                    icon-size: 16px;
                                    icon-color: Theme.color-ok;
                                }
                            }

                            Text {
                                text: "No pending friend requests.";
                                font-size: 13px;
                                color: Theme.text-mute;
                                vertical-alignment: center;
                            }
                        }

                        for req[idx] in root.requests : VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;

                                    Rectangle {
                                        width: 40px;
                                        height: 40px;
                                        border-radius: 20px;
                                        background: req.is-outgoing ? Theme.container-subtle : Theme.container;

                                        MaterialIcon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            name: req.is-outgoing ? "schedule" : "person_add";
                                            icon-size: 20px;
                                            icon-color: req.is-outgoing ? Theme.text-mute : Theme.on-container;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 2px;
                                        alignment: center;
                                        Text {
                                            text: req.tag;
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: Theme.text-ink;
                                            overflow: elide;
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;

                                            Rectangle {
                                                height: 20px;
                                                border-radius: Theme.radius-pill;
                                                background: req.is-outgoing ? Theme.container-subtle : Theme.ok-container;

                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 4px;
                                                    alignment: center;

                                                    VerticalLayout {
                                                        alignment: center;
                                                        MaterialIcon {
                                                            name: req.is-outgoing ? "schedule" : "arrow_forward";
                                                            icon-size: 11px;
                                                            icon-color: req.is-outgoing ? Theme.text-mute : Theme.color-ok;
                                                        }
                                                    }

                                                    Text {
                                                        text: req.is-outgoing ? "Outgoing request" : "Incoming request";
                                                        font-size: 11px;
                                                        font-weight: 500;
                                                        color: req.is-outgoing ? Theme.text-mute : Theme.color-ok;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Action buttons with clear icons
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    if !req.is-outgoing : Rectangle {
                                        height: 34px;
                                        border-radius: Theme.radius-pill;
                                        background: acc-btn.pressed ? Theme.on-mint :
                                                    acc-btn.has-hover ? Theme.accent : Theme.mint;
                                        animate background { duration: 120ms; }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 6px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                MaterialIcon {
                                                    name: "check";
                                                    icon-size: 14px;
                                                    icon-color: Theme.on-mint;
                                                }
                                            }

                                            Text {
                                                text: "Accept";
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: Theme.on-mint;
                                                vertical-alignment: center;
                                            }
                                        }

                                        acc-btn := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.accept-request(idx); }
                                        }
                                    }

                                    if !req.is-outgoing : Rectangle {
                                        height: 34px;
                                        border-radius: Theme.radius-pill;
                                        border-width: 1px;
                                        border-color: dec-btn.has-hover ? Theme.color-bad : Theme.border-line;
                                        background: dec-btn.has-hover ? Theme.bad-container : Theme.surface;
                                        animate background, border-color { duration: 120ms; }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 6px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                MaterialIcon {
                                                    name: "close";
                                                    icon-size: 14px;
                                                    icon-color: dec-btn.has-hover ? Theme.color-bad : Theme.text-mute;
                                                }
                                            }

                                            Text {
                                                text: "Decline";
                                                font-size: 12px;
                                                font-weight: 500;
                                                color: dec-btn.has-hover ? Theme.color-bad : Theme.text-ink;
                                                vertical-alignment: center;
                                            }
                                        }

                                        dec-btn := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.decline-request(idx); }
                                        }
                                    }

                                    if req.is-outgoing : Rectangle {
                                        height: 34px;
                                        border-radius: Theme.radius-pill;
                                        border-width: 1px;
                                        border-color: can-btn.has-hover ? Theme.color-bad : Theme.border-line;
                                        background: can-btn.has-hover ? Theme.bad-container : Theme.surface;
                                        animate background, border-color { duration: 120ms; }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 6px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                MaterialIcon {
                                                    name: "close";
                                                    icon-size: 14px;
                                                    icon-color: can-btn.has-hover ? Theme.color-bad : Theme.text-mute;
                                                }
                                            }

                                            Text {
                                                text: "Cancel";
                                                font-size: 12px;
                                                font-weight: 500;
                                                color: can-btn.has-hover ? Theme.color-bad : Theme.text-ink;
                                                vertical-alignment: center;
                                            }
                                        }

                                        can-btn := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.cancel-request(idx); }
                                        }
                                    }
                                }
                            }

                            if idx < root.requests.length - 1 : Rectangle {
                                height: 1px;
                                background: Theme.border-subtle;
                            }
                        }
                    }
                }
            }

            // Section: All friends
            VerticalLayout {
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;
                        MaterialIcon {
                            name: "friends";
                            icon-size: 18px;
                            icon-color: Theme.accent;
                        }
                    }

                    Text {
                        text: "All friends";
                        font-size: 18px;
                        font-weight: 600;
                        color: Theme.text-ink;
                    }

                    Rectangle {
                        height: 20px;
                        border-radius: Theme.radius-pill;
                        background: Theme.container;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            Text {
                                text: root.friends.length;
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.on-container;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-line;
                    border-radius: Theme.radius-card;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: Theme.shadow-color;

                    VerticalLayout {
                        padding: Theme.card-padding;
                        spacing: 16px;

                        if root.friends.length == 0 : VerticalLayout {
                            padding-top: 24px;
                            padding-bottom: 24px;
                            spacing: 14px;
                            alignment: center;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 60px;
                                    height: 60px;
                                    border-radius: 30px;
                                    background: Theme.container;

                                    MaterialIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        name: "group";
                                        icon-size: 30px;
                                        icon-color: Theme.accent;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "No Friends Added Yet";
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: Theme.text-ink;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Add friends using their gamertag above to stream games, share input, and pass controllers.";
                                    font-size: 13px;
                                    color: Theme.text-mute;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        for friend[idx] in root.friends : VerticalLayout {
                            spacing: 12px;

                            // Friend Top Row: Avatar, Name, Online Status, Actions
                            HorizontalLayout {
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;

                                    // Avatar with Online Status Indicator
                                    Rectangle {
                                        width: 42px;
                                        height: 42px;
                                        border-radius: 21px;
                                        background: friend.is-hosting ? Theme.ok-container : Theme.container;

                                        MaterialIcon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            name: friend.is-hosting ? "sports_esports" : "person";
                                            icon-size: 22px;
                                            icon-color: friend.is-hosting ? Theme.color-ok : Theme.on-container;
                                        }

                                        // Status dot overlay
                                        Rectangle {
                                            x: parent.width - 10px;
                                            y: parent.height - 10px;
                                            width: 10px;
                                            height: 10px;
                                            border-radius: 5px;
                                            border-width: 1.5px;
                                            border-color: Theme.surface;
                                            background: friend.is-hosting || friend.is-online ? Theme.color-ok : Theme.border-line;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 3px;
                                        alignment: center;

                                        Text {
                                            text: friend.tag;
                                            font-size: 15px;
                                            font-weight: 600;
                                            color: Theme.text-ink;
                                            overflow: elide;
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;

                                            if friend.is-hosting : Rectangle {
                                                height: 22px;
                                                border-radius: Theme.radius-pill;
                                                background: Theme.ok-container;

                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 5px;
                                                    alignment: center;

                                                    VerticalLayout {
                                                        alignment: center;
                                                        MaterialIcon {
                                                            name: "cast";
                                                            icon-size: 12px;
                                                            icon-color: Theme.color-ok;
                                                        }
                                                    }

                                                    Text {
                                                        text: "Hosting stream";
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: Theme.color-ok;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            if !friend.is-hosting && friend.is-online : Rectangle {
                                                height: 20px;
                                                border-radius: Theme.radius-pill;
                                                background: Theme.container-subtle;

                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 5px;
                                                    alignment: center;

                                                    Rectangle {
                                                        width: 6px;
                                                        height: 6px;
                                                        border-radius: 3px;
                                                        background: Theme.color-ok;
                                                        y: (parent.height - self.height) / 2;
                                                    }

                                                    Text {
                                                        text: "Online";
                                                        font-size: 11px;
                                                        font-weight: 500;
                                                        color: Theme.color-ok;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            if !friend.is-hosting && !friend.is-online : Rectangle {
                                                height: 20px;
                                                border-radius: Theme.radius-pill;
                                                background: Theme.container-subtle;

                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 5px;
                                                    alignment: center;

                                                    Rectangle {
                                                        width: 6px;
                                                        height: 6px;
                                                        border-radius: 3px;
                                                        background: Theme.text-disabled;
                                                        y: (parent.height - self.height) / 2;
                                                    }

                                                    Text {
                                                        text: "Offline";
                                                        font-size: 11px;
                                                        font-weight: 500;
                                                        color: Theme.text-mute;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Quick Actions: Join Stream & Remove Friend
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    if friend.is-hosting : Rectangle {
                                        height: 34px;
                                        border-radius: Theme.radius-pill;
                                        background: join-touch.pressed ? Theme.on-mint :
                                                    join-touch.has-hover ? Theme.accent : Theme.mint;
                                        animate background { duration: 120ms; }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 6px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                MaterialIcon {
                                                    name: "play_arrow";
                                                    icon-size: 15px;
                                                    icon-color: Theme.on-mint;
                                                }
                                            }

                                            Text {
                                                text: "Join Stream";
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: Theme.on-mint;
                                                vertical-alignment: center;
                                            }
                                        }

                                        join-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.connect-to-friend(friend.tag);
                                            }
                                        }
                                    }

                                    // Remove friend button with tooltip icon
                                    Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        border-radius: 17px;
                                        border-width: rem-touch.has-hover ? 1px : 0px;
                                        border-color: Theme.color-bad;
                                        background: rem-touch.has-hover ? Theme.bad-container : #00000000;
                                        animate background, border-color { duration: 120ms; }

                                        MaterialIcon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            name: "person_remove";
                                            icon-size: 18px;
                                            icon-color: rem-touch.has-hover ? Theme.color-bad : Theme.text-mute;
                                        }

                                        rem-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.remove-friend(idx); }
                                        }
                                    }
                                }
                            }

                            // Host Sharing Permissions Panel
                            Rectangle {
                                border-radius: Theme.radius-medium;
                                background: Theme.input-bg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                VerticalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    spacing: 8px;

                                    // Panel title
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            MaterialIcon {
                                                name: "tune";
                                                icon-size: 13px;
                                                icon-color: Theme.text-mute;
                                            }
                                        }

                                        Text {
                                            text: "STREAMING PERMISSIONS (WHEN THEY JOIN YOUR HOST)";
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: Theme.text-mute;
                                            letter-spacing: 0.5px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Permission Switches
                                    if !root.is-narrow : HorizontalLayout {
                                        spacing: 20px;
                                        alignment: space-between;

                                        // Mouse & Keyboard Option
                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 10px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: start;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 32px;
                                                        height: 32px;
                                                        border-radius: 8px;
                                                        background: friend.allow-input ? Theme.container : Theme.container-subtle;

                                                        MaterialIcon {
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            name: "mouse";
                                                            icon-size: 16px;
                                                            icon-color: friend.allow-input ? Theme.on-container : Theme.text-mute;
                                                        }
                                                    }
                                                }

                                                VerticalLayout {
                                                    spacing: 1px;
                                                    alignment: center;
                                                    Text {
                                                        text: "Mouse & Keyboard";
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        color: Theme.text-ink;
                                                    }
                                                    Text {
                                                        text: "Allow remote click and key input";
                                                        font-size: 11px;
                                                        color: Theme.text-mute;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                M3Switch {
                                                    checked: friend.allow-input;
                                                    toggled(v) => { root.friend-input-toggled(idx, v); }
                                                }
                                            }
                                        }

                                        Rectangle {
                                            width: 1px;
                                            background: Theme.border-subtle;
                                        }

                                        // Gamepad Option
                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 10px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: start;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 32px;
                                                        height: 32px;
                                                        border-radius: 8px;
                                                        background: friend.allow-gamepad ? Theme.container : Theme.container-subtle;

                                                        MaterialIcon {
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            name: "sports_esports";
                                                            icon-size: 16px;
                                                            icon-color: friend.allow-gamepad ? Theme.on-container : Theme.text-mute;
                                                        }
                                                    }
                                                }

                                                VerticalLayout {
                                                    spacing: 1px;
                                                    alignment: center;
                                                    Text {
                                                        text: "Virtual Gamepad";
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        color: Theme.text-ink;
                                                    }
                                                    Text {
                                                        text: "Allow virtual gamepad connection";
                                                        font-size: 11px;
                                                        color: Theme.text-mute;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                M3Switch {
                                                    checked: friend.allow-gamepad;
                                                    toggled(v) => { root.friend-gamepad-toggled(idx, v); }
                                                }
                                            }
                                        }
                                    }

                                    if root.is-narrow : VerticalLayout {
                                        spacing: 10px;

                                        // Mouse & Keyboard Option
                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: start;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 32px;
                                                        height: 32px;
                                                        border-radius: 8px;
                                                        background: friend.allow-input ? Theme.container : Theme.container-subtle;

                                                        MaterialIcon {
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            name: "mouse";
                                                            icon-size: 16px;
                                                            icon-color: friend.allow-input ? Theme.on-container : Theme.text-mute;
                                                        }
                                                    }
                                                }

                                                VerticalLayout {
                                                    spacing: 1px;
                                                    alignment: center;
                                                    Text {
                                                        text: "Mouse & Keyboard";
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        color: Theme.text-ink;
                                                    }
                                                    Text {
                                                        text: "Allow remote click and key input";
                                                        font-size: 11px;
                                                        color: Theme.text-mute;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                M3Switch {
                                                    checked: friend.allow-input;
                                                    toggled(v) => { root.friend-input-toggled(idx, v); }
                                                }
                                            }
                                        }

                                        Rectangle {
                                            height: 1px;
                                            background: Theme.border-subtle;
                                        }

                                        // Gamepad Option
                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: start;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 32px;
                                                        height: 32px;
                                                        border-radius: 8px;
                                                        background: friend.allow-gamepad ? Theme.container : Theme.container-subtle;

                                                        MaterialIcon {
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            name: "sports_esports";
                                                            icon-size: 16px;
                                                            icon-color: friend.allow-gamepad ? Theme.on-container : Theme.text-mute;
                                                        }
                                                    }
                                                }

                                                VerticalLayout {
                                                    spacing: 1px;
                                                    alignment: center;
                                                    Text {
                                                        text: "Virtual Gamepad";
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        color: Theme.text-ink;
                                                    }
                                                    Text {
                                                        text: "Allow virtual gamepad connection";
                                                        font-size: 11px;
                                                        color: Theme.text-mute;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                M3Switch {
                                                    checked: friend.allow-gamepad;
                                                    toggled(v) => { root.friend-gamepad-toggled(idx, v); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if idx < root.friends.length - 1 : Rectangle {
                                height: 1px;
                                background: Theme.border-line;
                            }
                        }
                    }
                }
            }
        }
    }
}
